<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <!-- Приводим тип колонки к DOUBLE PRECISION, как ожидает Hibernate для Double. -->
    <changeSet id="07-fix-price-per-square-meter-type" author="bunaev">
        <sql>
            ALTER TABLE apartment
            ALTER COLUMN price_per_square_meter TYPE DOUBLE PRECISION;
        </sql>
        <rollback>
            ALTER TABLE apartment
            ALTER COLUMN price_per_square_meter TYPE NUMERIC(15, 2);
        </rollback>
    </changeSet>

</databaseChangeLog>