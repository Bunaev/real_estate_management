<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <!-- Индекс на location_id в таблице district -->
    <changeSet id="12-add-index-district-location" author="bunaev">
        <createIndex tableName="district" indexName="idx_district_location">
            <column name="location_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="district" indexName="idx_district_location"/>
        </rollback>
    </changeSet>

    <!-- Индекс на district_id в таблице residential_complex -->
    <changeSet id="13-add-index-rc-district" author="bunaev">
        <createIndex tableName="residential_complex" indexName="idx_rc_district">
            <column name="district_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="residential_complex" indexName="idx_rc_district"/>
        </rollback>
    </changeSet>

    <!-- Индекс на developer_id в таблице residential_complex -->
    <changeSet id="14-add-index-rc-developer" author="bunaev">
        <createIndex tableName="residential_complex" indexName="idx_rc_developer">
            <column name="developer_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="residential_complex" indexName="idx_rc_developer"/>
        </rollback>
    </changeSet>

    <!-- САМЫЙ ВАЖНЫЙ: составной индекс на связку ЖК-Метро -->
    <changeSet id="15-add-index-cmd-composite" author="bunaev">
        <createIndex tableName="complex_metro_distance" indexName="idx_cmd_rc_ms">
            <column name="residential_complex_id"/>
            <column name="metro_station_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="complex_metro_distance" indexName="idx_cmd_rc_ms"/>
        </rollback>
    </changeSet>

    <!-- Индекс для быстрой сортировки по расстоянию -->
    <changeSet id="16-add-index-cmd-distance" author="bunaev">
        <createIndex tableName="complex_metro_distance" indexName="idx_cmd_distance">
            <column name="distance"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="complex_metro_distance" indexName="idx_cmd_distance"/>
        </rollback>
    </changeSet>
    <!-- ========================================================= -->
    <!-- НОВЫЕ ИНДЕКСЫ                                             -->
    <!-- ========================================================= -->
    <changeSet id="17-add-index-building-rc" author="bunaev">
        <createIndex tableName="building" indexName="idx_building_rc">
            <column name="residential_complex_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="building" indexName="idx_building_rc"/>
        </rollback>
    </changeSet>

    <changeSet id="18-add-index-entrance-building" author="bunaev">
        <createIndex tableName="entrance" indexName="idx_entrance_building">
            <column name="building_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="entrance" indexName="idx_entrance_building"/>
        </rollback>
    </changeSet>

    <changeSet id="19-add-index-apartment-entrance" author="bunaev">
        <createIndex tableName="apartment" indexName="idx_apartment_entrance">
            <column name="entrance_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="apartment" indexName="idx_apartment_entrance"/>
        </rollback>
    </changeSet>

</databaseChangeLog>