<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <!-- ========================================================= -->
    <!-- ТАБЛИЦА 1: location (Регион/Город)                        -->
    <!-- ========================================================= -->
    <!-- Связей нет. Создаем первой.                               -->
    <changeSet id="01-create-location" author="bunaev">
        <createTable tableName="location">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="location"/>
        </rollback>
    </changeSet>

    <!-- ========================================================= -->
    <!-- ТАБЛИЦА 2: developer (Застройщик)                         -->
    <!-- ========================================================= -->
    <!-- Связей нет. Создаем второй.                               -->
    <changeSet id="02-create-developer" author="bunaev">
        <createTable tableName="developer">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="developer"/>
        </rollback>
    </changeSet>

    <!-- ========================================================= -->
    <!-- ТАБЛИЦА 3: district (Район)                               -->
    <!-- ========================================================= -->
    <!-- У района есть внешний ключ на location, НО мы его        -->
    <!-- не добавляем сейчас, чтобы не нарушать порядок.          -->
    <!-- Колонку location_id создаем, а FK добавим позже.         -->
    <changeSet id="03-create-district" author="bunaev">
        <createTable tableName="district">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <!-- Это внешний ключ, но пока просто колонка -->
            <column name="location_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="district"/>
        </rollback>
    </changeSet>

    <!-- ========================================================= -->
    <!-- ТАБЛИЦА 4: metro_station (Станция метро)                 -->
    <!-- ========================================================= -->
    <!-- Связей нет. Создаем.                                      -->
    <changeSet id="04-create-metro-station" author="bunaev">
        <createTable tableName="metro_station">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="metro_station"/>
        </rollback>
    </changeSet>

    <!-- ========================================================= -->
    <!-- ТАБЛИЦА 5: residential_complex (Жилой комплекс)          -->
    <!-- ========================================================= -->
    <!-- У ЖК есть внешние ключи на district и developer.         -->
    <!-- Создаем колонки, но FK добавим позже.                    -->
    <changeSet id="05-create-residential-complex" author="bunaev">
        <createTable tableName="residential_complex">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="address" type="VARCHAR(500)"/>
            <!-- Внешний ключ на район -->
            <column name="district_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <!-- Внешний ключ на застройщика -->
            <column name="developer_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="residential_complex"/>
        </rollback>
    </changeSet>

    <!-- ========================================================= -->
    <!-- ТАБЛИЦА 6: complex_metro_distance (Связка ЖК и Метро)   -->
    <!-- ========================================================= -->
    <!-- САМАЯ СЛОЖНАЯ. Это связь Many-to-Many с доп. полем.     -->
    <!-- У нее есть внешние ключи на residential_complex и        -->
    <!-- metro_station. Создаем колонки, FK добавим позже.        -->
    <changeSet id="06-create-complex-metro-distance" author="bunaev">
        <createTable tableName="complex_metro_distance">
            <!-- Первичный ключ самой связки -->
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <!-- Внешний ключ на ЖК -->
            <column name="residential_complex_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <!-- Внешний ключ на станцию метро -->
            <column name="metro_station_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <!-- ДОП. ПОЛЕ, ради которого все затевалось -->
            <column name="distance" type="INTEGER">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="complex_metro_distance"/>
        </rollback>
    </changeSet>
    <!-- ========================================================= -->
    <!-- ТАБЛИЦА 7: building (Корпус/Дом)                         -->
    <!-- ========================================================= -->
    <changeSet id="07-create-building" author="bunaev">
        <createTable tableName="building">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="residential_complex_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="building"/>
        </rollback>
    </changeSet>

    <!-- ========================================================= -->
    <!-- ТАБЛИЦА 8: entrance (Подъезд/Секция)                    -->
    <!-- ========================================================= -->
    <changeSet id="08-create-entrance" author="bunaev">
        <createTable tableName="entrance">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="building_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="entrance"/>
        </rollback>
    </changeSet>

    <!-- ========================================================= -->
    <!-- ТАБЛИЦА 9: apartment (Квартира)                         -->
    <!-- ========================================================= -->
    <changeSet id="09-create-apartment" author="bunaev">
        <createTable tableName="apartment">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="entrance_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="apartment"/>
        </rollback>
    </changeSet>

    <changeSet id="add-columns-to-apartment" author="bunaev">
        <addColumn tableName="apartment">
            <column name="price" type="NUMERIC(15, 2)">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="apartment">
            <column name="floor" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="entrance">
            <column name="max_floors" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="apartment">
            <column name="area" type="NUMERIC(3,1)">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="apartment">
            <column name="has_balcony" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="building">
            <column name="completion_date" type="DATE">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="building">
            <column name="key_handover_date" type="DATE">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="apartment">
            <column name="number" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="apartment">
            <column name="status" type="VARCHAR(50)" defaultValue="AVAILABLE">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="apartment">
            <column name="bathroom_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
